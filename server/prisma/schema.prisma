generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Player {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  team        String?
  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}

model Match {
  id        Int      @id @default(autoincrement())
  homeId    Int
  awayId    Int
  homeScore Int?
  awayScore Int?
  played    Boolean  @default(false)
  stage     String   @default("GROUP")
  slot      Int      @default(0)
  createdAt DateTime @default(now())
  home      Player   @relation("home", fields: [homeId], references: [id], onDelete: Cascade)
  away      Player   @relation("away", fields: [awayId], references: [id], onDelete: Cascade)
}